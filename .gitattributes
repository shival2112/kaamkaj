# Normalize line endings for all text files
* text=auto eol=lf

# Force LF for source files
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.prisma text eol=lf
*.env   text eol=lf

# Binary files — no line-ending conversion
*.woff  binary
*.woff2 binary
*.ico   binary
*.png   binary
*.jpg   binary
*.docx  binary
