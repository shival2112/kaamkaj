// KaamKaaj Database Schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum JobType {
  FULL_TIME
  PART_TIME
  REMOTE
  CONTRACT
  INTERNSHIP
}

enum ExperienceLevel {
  FRESHER
  JUNIOR
  MID
  SENIOR
  LEAD
}

enum JobStatus {
  ACTIVE
  CLOSED
  DRAFT
  EXPIRED
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  SHORTLISTED
  REJECTED
  HIRED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?
  passwordHash String?  @map("password_hash")
  role         Role     @default(CANDIDATE)
  name         String
  avatar       String?
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  company      Company?
  applications Application[]
  savedJobs    SavedJob[]
  resume       Resume?

  @@map("users")
}

model Company {
  id          String   @id @default(uuid())
  name        String
  logo        String?
  website     String?
  size        String?  // e.g. "1-10", "11-50", "51-200", "201-500", "500+"
  industry    String?
  description String?
  isVerified  Boolean  @default(false) @map("is_verified")
  ownerId     String   @unique @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  owner User  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  jobs  Job[]

  @@map("companies")
}

model Job {
  id              String          @id @default(uuid())
  title           String
  description     String
  companyId       String          @map("company_id")
  location        String
  salaryMin       Int?            @map("salary_min")
  salaryMax       Int?            @map("salary_max")
  type            JobType         @default(FULL_TIME)
  experienceLevel ExperienceLevel @default(FRESHER) @map("experience_level")
  status          JobStatus       @default(ACTIVE)
  vacancies       Int             @default(1)
  skills          String[]        @default([])
  expiresAt       DateTime?       @map("expires_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // Relations
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]
  savedByUsers SavedJob[]

  // Indexes for common query patterns
  @@index([companyId])
  @@index([status, type])
  @@index([location])
  @@index([createdAt(sort: Desc)])
  @@map("jobs")
}

model Application {
  id          String            @id @default(uuid())
  jobId       String            @map("job_id")
  candidateId String            @map("candidate_id")
  status      ApplicationStatus @default(APPLIED)
  resumeUrl   String?           @map("resume_url")
  coverLetter String?           @map("cover_letter")
  appliedAt   DateTime          @default(now()) @map("applied_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  // Relations
  job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate User @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // One application per candidate per job
  @@unique([jobId, candidateId])
  @@index([candidateId])
  @@index([jobId])
  @@map("applications")
}

model SavedJob {
  userId  String   @map("user_id")
  jobId   String   @map("job_id")
  savedAt DateTime @default(now()) @map("saved_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
  @@map("saved_jobs")
}

model Resume {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  fileUrl    String   @map("file_url")
  parsedData Json?    @map("parsed_data") // stores { skills: [], experience: [], education: [] }
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("resumes")
}
