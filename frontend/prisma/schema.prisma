// KaamKaaj Database Schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  CANDIDATE
  EMPLOYER
  RECRUITER
  ADMIN
}

enum JobType {
  FULL_TIME
  PART_TIME
  REMOTE
  CONTRACT
  INTERNSHIP
}

enum ExperienceLevel {
  FRESHER
  JUNIOR
  MID
  SENIOR
  LEAD
}

enum JobStatus {
  ACTIVE
  CLOSED
  DRAFT
  EXPIRED
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  SHORTLISTED
  REJECTED
  HIRED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  phone               String?
  passwordHash        String?   @map("password_hash")
  role                Role      @default(CANDIDATE)
  name                String
  avatar              String?
  isVerified          Boolean   @default(false) @map("is_verified")
  emailVerified       Boolean   @default(false) @map("email_verified")
  verificationToken   String?   @unique @map("verification_token")
  verificationExpiry  DateTime? @map("verification_expiry")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  recruiterCompanyId  String?   @map("recruiter_company_id")

  // Relations
  company                  Company?       @relation("CompanyOwner")
  recruiterCompany         Company?       @relation("CompanyRecruiters", fields: [recruiterCompanyId], references: [id], onDelete: SetNull)
  applications             Application[]
  savedJobs                SavedJob[]
  resume                   Resume?
  companyReviews           CompanyReview[]
  jobTemplates             JobTemplate[]
  meetingsAsParticipant    Meeting[]      @relation("MeetingParticipant")
  meetingsScheduled        Meeting[]      @relation("MeetingScheduledBy")
  jobReports               JobReport[]

  @@map("users")
}

model Company {
  id          String   @id @default(uuid())
  name        String
  logo        String?
  website     String?
  size        String?  // e.g. "1-10", "11-50", "51-200", "201-500", "500+"
  industry    String?
  description String?
  isVerified  Boolean  @default(false) @map("is_verified")
  ownerId     String   @unique @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  owner      User            @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  recruiters User[]          @relation("CompanyRecruiters")
  jobs       Job[]
  reviews    CompanyReview[]

  @@map("companies")
}

model Job {
  id              String          @id @default(uuid())
  title           String
  description     String
  companyId       String          @map("company_id")
  location        String
  salaryMin       Int?            @map("salary_min")
  salaryMax       Int?            @map("salary_max")
  type            JobType         @default(FULL_TIME)
  experienceLevel ExperienceLevel @default(FRESHER) @map("experience_level")
  status          JobStatus       @default(ACTIVE)
  vacancies       Int             @default(1)
  skills          String[]        @default([])
  isUrgent        Boolean         @default(false) @map("is_urgent")
  expiresAt       DateTime?       @map("expires_at")
  viewCount       Int             @default(0) @map("view_count")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // Relations
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]
  savedByUsers SavedJob[]
  meetings     Meeting[]
  reports      JobReport[]

  // Indexes for common query patterns
  @@index([companyId])
  @@index([status, type])
  @@index([location])
  @@index([createdAt(sort: Desc)])
  @@map("jobs")
}

model Application {
  id              String            @id @default(uuid())
  jobId           String            @map("job_id")
  candidateId     String            @map("candidate_id")
  status          ApplicationStatus @default(APPLIED)
  resumeUrl       String?           @map("resume_url")
  coverLetter     String?           @map("cover_letter")
  employerNotes   String?           @map("employer_notes")
  rejectionReason String?           @map("rejection_reason")
  rating          Int?              // 1–5 employer rating after interview
  appliedAt       DateTime          @default(now()) @map("applied_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  // Relations
  job        Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate  User                   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  statusLogs ApplicationStatusLog[]

  // One application per candidate per job
  @@unique([jobId, candidateId])
  @@index([candidateId])
  @@index([jobId])
  @@map("applications")
}

model ApplicationStatusLog {
  id            String            @id @default(uuid())
  applicationId String            @map("application_id")
  status        ApplicationStatus
  changedAt     DateTime          @default(now()) @map("changed_at")
  changedBy     String            @map("changed_by")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_status_logs")
}

model SavedJob {
  userId  String   @map("user_id")
  jobId   String   @map("job_id")
  savedAt DateTime @default(now()) @map("saved_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
  @@map("saved_jobs")
}

model CompanyReview {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  candidateId String   @map("candidate_id")
  rating      Int      // 1–5
  title       String
  body        String?
  createdAt   DateTime @default(now()) @map("created_at")

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate User    @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([companyId, candidateId])
  @@index([companyId])
  @@map("company_reviews")
}

model JobTemplate {
  id         String   @id @default(uuid())
  employerId String   @map("employer_id")
  name       String
  data       Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  employer User @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@index([employerId])
  @@map("job_templates")
}

model Resume {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  fileUrl    String   @map("file_url")
  parsedData Json?    @map("parsed_data") // stores { skills: [], experience: [], education: [] }
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("resumes")
}

// ─── Phone-based Auth Models (NextAuth / OTP flow) ────────────────────────────
// Separate from Supabase User — used by employer + candidate phone login.

enum PhoneRole {
  CANDIDATE
  EMPLOYER
}

model PhoneUser {
  id        String          @id @default(cuid())
  name      String
  phone     String          @unique
  role      PhoneRole       @default(CANDIDATE)
  createdAt DateTime        @default(now()) @map("created_at")

  candidate PhoneCandidate?
  employer  PhoneEmployer?

  @@map("phone_users")
}

model PhoneCandidate {
  id     String    @id @default(cuid())
  userId String    @unique @map("user_id")
  user   PhoneUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("phone_candidates")
}

model PhoneEmployer {
  id          String    @id @default(cuid())
  userId      String    @unique @map("user_id")
  user        PhoneUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String    @map("company_name")
  industry    String    @default("Technology")
  location    String    @default("India")
  about       String    @default("")

  @@map("phone_employers")
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("site_settings")
}

model Meeting {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  jobId            String?  @map("job_id")
  round            String
  date             String
  time             String
  mode             String
  link             String?
  interviewer      String
  status           String   @default("scheduled")
  scheduledBy      String   @map("scheduled_by")
  feedbackOutcome  String?  @map("feedback_outcome")  // PASSED | FAILED | NO_SHOW
  feedbackRating   Int?     @map("feedback_rating")   // 1–5
  feedbackNotes    String?  @map("feedback_notes")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  participant     User  @relation("MeetingParticipant", fields: [userId], references: [id], onDelete: Cascade)
  job             Job?  @relation(fields: [jobId], references: [id], onDelete: SetNull)
  scheduledByUser User  @relation("MeetingScheduledBy", fields: [scheduledBy], references: [id])

  @@index([userId])
  @@index([status])
  @@map("meetings")
}

model JobReport {
  id         String   @id @default(uuid())
  jobId      String   @map("job_id")
  reporterId String   @map("reporter_id")
  reason     String
  createdAt  DateTime @default(now()) @map("created_at")

  job      Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([jobId, reporterId])
  @@index([jobId])
  @@map("job_reports")
}
