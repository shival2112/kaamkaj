# ─── Prisma / Supabase DB ────────────────────────────────────────────────────
# Transaction mode (port 6543) — for PrismaClient at runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Session mode (port 5432) — for Prisma migrations / db push
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ─── Supabase Auth ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"

# ─── App ─────────────────────────────────────────────────────────────────────
# Used for OAuth callback redirects — set to your Vercel deployment URL
NEXT_PUBLIC_SITE_URL="https://[YOUR-DOMAIN].vercel.app"
